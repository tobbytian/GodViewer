<?xml version="1.0" encoding="utf-8"?>
<!-- 危险按钮：error container 实底 + 与卡片/开关同款 2dp 渐变环（14dp 圆角） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#C6CBD4"
                android:startColor="#FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/md_theme_light_errorContainer" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>