<?xml version="1.0" encoding="utf-8"?>
<!-- 中性 pill 按钮：新拟物凸起 + 按压涟漪 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#1F000000">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="315"
                        android:endColor="#C6CBD4"
                        android:startColor="#FFFFFF" />
                    <corners android:radius="28dp" />
                </shape>
            </item>
            <item
                android:bottom="2dp"
                android:left="2dp"
                android:right="2dp"
                android:top="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/home_page_background" />
                    <corners android:radius="26dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>