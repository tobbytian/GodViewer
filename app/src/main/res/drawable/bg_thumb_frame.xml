<?xml version="1.0" encoding="utf-8"?>
<!-- 规则缩略图：凹陷井（clipToOutline 按外层 16dp 圆角裁剪图片） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#FFFFFF"
                android:startColor="#C6CBD4" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/home_page_background" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>