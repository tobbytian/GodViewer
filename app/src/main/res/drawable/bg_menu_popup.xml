<?xml version="1.0" encoding="utf-8"?>
<!-- 溢出菜单面板：新拟物凸起（环 r14），上下 6dp 内边距保留 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#C6CBD4"
                android:startColor="#FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/home_page_background" />
            <corners android:radius="12dp" />
            <padding
                android:bottom="6dp"
                android:top="6dp" />
        </shape>
    </item>
</layer-list>