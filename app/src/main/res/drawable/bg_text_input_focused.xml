<?xml version="1.0" encoding="utf-8"?>
<!-- 输入框聚焦态：浅凹陷（1dp 内环）——通道打开，内阴影变浅而不是加深 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#FFFFFF"
                android:startColor="#C6CBD4" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/home_page_background" />
            <corners android:radius="13dp" />
            <padding
                android:bottom="10dp"
                android:left="12dp"
                android:right="12dp"
                android:top="10dp" />
        </shape>
    </item>
</layer-list>