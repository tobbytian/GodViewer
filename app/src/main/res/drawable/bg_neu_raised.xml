<?xml version="1.0" encoding="utf-8"?>
<!--
  新拟物「凸起」面（Android 无双色投影 API，用 2dp 渐变环近似）：
  光源固定左上 → 环左上白高光 #FFFFFF、右下暗影 #C6CBD4；面与页面同色。
  angle 315 = 起点左上 → 终点右下。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#C6CBD4"
                android:startColor="#FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/home_page_background" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>