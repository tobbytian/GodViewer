<?xml version="1.0" encoding="utf-8"?>
<!-- dock 背景：玻璃改为新拟物凸起条（规范禁玻璃态作默认）；面与页面同色，环定义边界 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#C6CBD4"
                android:startColor="#FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/home_page_background" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>