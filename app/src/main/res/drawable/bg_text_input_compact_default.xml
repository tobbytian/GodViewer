<?xml version="1.0" encoding="utf-8"?>
<!-- 并排小输入框默认态：2dp 内环（普通输入框 3dp），四框挨着时边框不显厚 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#FFFFFF"
                android:startColor="#C6CBD4" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/home_page_background" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>