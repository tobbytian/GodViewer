<?xml version="1.0" encoding="utf-8"?>
<!-- 中性按钮默认态：凸起（r14） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#C6CBD4"
                android:startColor="#FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/home_page_background" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>