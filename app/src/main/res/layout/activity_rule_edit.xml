<?xml version="1.0" encoding="utf-8"?>
<!-- 规则编辑页（宿主）：每张卡 = 一个 changed* 属性组（开关）+ 可编辑的修改值；原始值不可改 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_page_background"
    android:orientation="vertical"
    tools:context=".host.RuleMirrorRuleEditActivity">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/HostSecondaryToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:popupTheme="@style/ThemeOverlay.HostPopupMenu"
        tools:title="@string/rule_edit" />
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rule_edit_intro"
                android:textColor="@color/home_subtitle_text"
                android:textSize="13sp" />
            <!-- 尺寸 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_neu_raised"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/size"
                            android:textColor="@color/home_title_text"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/sizeSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:thumb="@drawable/bg_switch_thumb_flat"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp"
                            app:track="@drawable/bg_switch_track_flat"
                            app:thumbTint="@null"
                            app:trackTint="@null"
                            app:useMaterialThemeColors="false" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/sizeFields"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">
                        <EditText
                            android:id="@+id/widthInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_text_input"
                            android:hint="@string/width"
                            android:importantForAutofill="no"
                            android:inputType="numberSigned"
                            android:padding="10dp"
                            android:textColor="@color/home_title_text"
                            android:textSize="14sp" />
                        <EditText
                            android:id="@+id/heightInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_text_input"
                            android:hint="@string/height"
                            android:importantForAutofill="no"
                            android:inputType="numberSigned"
                            android:padding="10dp"
                            android:textColor="@color/home_title_text"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
            <!-- 外边距 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_neu_raised"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/margin"
                            android:textColor="@color/home_title_text"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/marginSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:thumb="@drawable/bg_switch_thumb_flat"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp"
                            app:track="@drawable/bg_switch_track_flat"
                            app:thumbTint="@null"
                            app:trackTint="@null"
                            app:useMaterialThemeColors="false" />
                    </LinearLayout>
                    <EditText
                        android:id="@+id/marginInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_text_input"
                        android:hint="@string/edit_dims_hint"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:padding="10dp"
                        android:textColor="@color/home_title_text"
                        android:textSize="14sp" />
                </LinearLayout>
            </FrameLayout>
            <!-- 内边距 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_neu_raised"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/padding"
                            android:textColor="@color/home_title_text"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/paddingSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:thumb="@drawable/bg_switch_thumb_flat"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp"
                            app:track="@drawable/bg_switch_track_flat"
                            app:thumbTint="@null"
                            app:trackTint="@null"
                            app:useMaterialThemeColors="false" />
                    </LinearLayout>
                    <EditText
                        android:id="@+id/paddingInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_text_input"
                        android:hint="@string/edit_dims_hint"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:padding="10dp"
                        android:textColor="@color/home_title_text"
                        android:textSize="14sp" />
                </LinearLayout>
            </FrameLayout>
            <!-- 可见性 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_neu_raised"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/visibility"
                            android:textColor="@color/home_title_text"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/visibilitySwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:thumb="@drawable/bg_switch_thumb_flat"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp"
                            app:track="@drawable/bg_switch_track_flat"
                            app:thumbTint="@null"
                            app:trackTint="@null"
                            app:useMaterialThemeColors="false" />
                    </LinearLayout>
                    <Spinner
                        android:id="@+id/visibilitySpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_spinner"
                        android:minHeight="44dp" />
                </LinearLayout>
            </FrameLayout>
            <!-- 文本（含最大行数） -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_neu_raised"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/text_content"
                            android:textColor="@color/home_title_text"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/textSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:thumb="@drawable/bg_switch_thumb_flat"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp"
                            app:track="@drawable/bg_switch_track_flat"
                            app:thumbTint="@null"
                            app:trackTint="@null"
                            app:useMaterialThemeColors="false" />
                    </LinearLayout>
                    <EditText
                        android:id="@+id/textInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_text_input"
                        android:gravity="top"
                        android:hint="@string/text_content"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine"
                        android:minLines="2"
                        android:padding="10dp"
                        android:textColor="@color/home_title_text"
                        android:textSize="14sp" />
                    <EditText
                        android:id="@+id/maxLinesInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_text_input"
                        android:hint="@string/max_line"
                        android:importantForAutofill="no"
                        android:inputType="numberSigned"
                        android:padding="10dp"
                        android:textColor="@color/home_title_text"
                        android:textSize="14sp" />
                </LinearLayout>
            </FrameLayout>
            <!-- 提示（hint） -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_neu_raised"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/text_hint"
                            android:textColor="@color/home_title_text"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/hintSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:thumb="@drawable/bg_switch_thumb_flat"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp"
                            app:track="@drawable/bg_switch_track_flat"
                            app:thumbTint="@null"
                            app:trackTint="@null"
                            app:useMaterialThemeColors="false" />
                    </LinearLayout>
                    <EditText
                        android:id="@+id/hintInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_text_input"
                        android:hint="@string/text_hint"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:padding="10dp"
                        android:textColor="@color/home_title_text"
                        android:textSize="14sp" />
                </LinearLayout>
            </FrameLayout>
            <!-- 图片（URL + scaleType） -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_neu_raised"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/image_url"
                            android:textColor="@color/home_title_text"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/imageSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:thumb="@drawable/bg_switch_thumb_flat"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp"
                            app:track="@drawable/bg_switch_track_flat"
                            app:thumbTint="@null"
                            app:trackTint="@null"
                            app:useMaterialThemeColors="false" />
                    </LinearLayout>
                    <EditText
                        android:id="@+id/imageUrlInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_text_input"
                        android:hint="@string/image_url"
                        android:importantForAutofill="no"
                        android:inputType="textUri"
                        android:padding="10dp"
                        android:textColor="@color/home_title_text"
                        android:textSize="14sp" />
                    <Spinner
                        android:id="@+id/scaleTypeSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_spinner"
                        android:minHeight="44dp" />
                </LinearLayout>
            </FrameLayout>
            <!-- 保存（主操作，深色卡片与详情页删除卡对称） -->
            <FrameLayout
                android:id="@+id/saveButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:background="@drawable/bg_panel_dark"
                >
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="16dp"
                    android:text="@string/rule_edit_save"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>