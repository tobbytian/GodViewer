<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_page_background"
    android:orientation="vertical"
    tools:context=".RuleMirrorDetailActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/HostSecondaryToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:popupTheme="@style/ThemeOverlay.HostPopupMenu"
        tools:title="Example App" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/appIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@null"
            tools:src="@mipmap/ic_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/appLabelView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/home_title_text"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Example App" />

            <TextView
                android:id="@+id/packageNameView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textColor="@color/home_subtitle_text"
                android:textSize="12sp"
                tools:text="com.example.app" />
        </LinearLayout>
    </LinearLayout>

    <!-- 本体通知（每应用）：包在新拟物卡片里，与下方弹窗设置入口同语言 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_neu_raised">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="4dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mirror_detail_notify_title"
                android:textColor="@color/home_title_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/appNotifyHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/mirror_detail_notify_subtitle"
                android:textColor="@color/home_subtitle_text"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/appNotifySwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:thumb="@drawable/bg_switch_thumb_flat"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            app:track="@drawable/bg_switch_track_flat"
            app:thumbTint="@null"
            app:trackTint="@null"
            app:useMaterialThemeColors="false" />
    </LinearLayout>
    </FrameLayout>

    <!-- 弹窗检测设置：二级菜单入口（开关 / 时长 / 规则在 PopupSettingsActivity 维护） -->
    <LinearLayout
        android:id="@+id/popupSettingsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_neu_raised"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/popup_settings_title"
            android:textColor="@color/home_title_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_arrow_forward_24" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="16dp"
            tools:listitem="@layout/item_mirrored_rule" />

        <TextView
            android:id="@+id/emptyView"
            style="@style/HostEmptyText"
            android:text="@string/mirror_detail_empty"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
