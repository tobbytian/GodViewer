<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_page_background"
    android:orientation="vertical"
    tools:context=".host.ui.PopupRulesActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/HostSecondaryToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/popup_rules_title" />

    <TextView
        style="@style/HostPageHint"
        android:text="@string/popup_rules_hint" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="16dp" />

        <TextView
            android:id="@+id/emptyView"
            style="@style/HostEmptyText"
            android:text="@string/popup_rules_empty"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
