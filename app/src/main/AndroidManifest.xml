<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- libxposed/service(+interface) 库 minSdk 26，高于本模块声明的 23；能跑 LSPosed 的设备必然 ≥26 -->
    <uses-sdk tools:overrideLibrary="io.github.libxposed.service,io.github.libxposed.service.interfaces" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 判断镜像对应的应用是否仍已安装（已卸载的不再列出） -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Resolve mirrored app labels/icons on Android 11+ -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".host.GodViewerApp"
        android:allowBackup="true"
        android:description="@string/app_description"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!--
          libxposed API 102 模块：模块身份由 META-INF/xposed/module.prop + java_init.list 声明，
          名称 / 描述来自 android:label / android:description，不再使用旧 xposedmodule metadata。
        -->
        <!--
          Desktop icon is optional (LauncherAlias).
          MODULE_SETTINGS lets LSPosed open this UI from the module page
          even when the launcher alias is disabled.
        -->
        <activity
            android:name=".host.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".LauncherAlias"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".host.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".host.ui.SimpleTextActivity"
            android:exported="false"
            android:parentActivityName=".host.MainActivity" />

        <activity
            android:name=".host.ui.DonateActivity"
            android:exported="false"
            android:parentActivityName=".host.MainActivity" />

        <activity
            android:name=".host.ui.SettingsInfoActivity"
            android:exported="false"
            android:parentActivityName=".host.MainActivity" />


        <activity
            android:name=".host.ui.PopupLogActivity"
            android:exported="false"
            android:parentActivityName=".host.MainActivity" />

        <activity
            android:name=".host.ui.PopupSettingsActivity"
            android:exported="false"
            android:parentActivityName=".host.RuleMirrorDetailActivity" />

        <activity
            android:name=".host.ui.PopupRulesActivity"
            android:exported="false"
            android:parentActivityName=".host.MainActivity" />

        <activity
            android:name=".host.RuleMirrorListActivity"
            android:exported="false"
            android:parentActivityName=".host.MainActivity" />

        <activity
            android:name=".host.RuleMirrorDetailActivity"
            android:exported="false"
            android:parentActivityName=".host.MainActivity" />

        <activity
            android:name=".host.RuleMirrorRuleDetailActivity"
            android:exported="false"
            android:parentActivityName=".host.RuleMirrorDetailActivity" />

        <activity
            android:name=".host.RuleMirrorRuleEditActivity"
            android:exported="false"
            android:parentActivityName=".host.RuleMirrorRuleDetailActivity" />

        <!--
          规则导出分享：cache/godviewer-share 下的 JSON 经 FileProvider 授权给
          ACTION_SEND 接收方（纯宿主侧新增组件，不涉及冻结的 3 个协议 FQCN）。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.godviewer.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Explicit component from target processes; exported so other UIDs can deliver. -->
        <receiver
            android:name=".data.RuleMirrorReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.godviewer.app.ACTION_MIRROR_RULES" />
            </intent-filter>
        </receiver>

        <!-- Host control: target foreground reports + notification action buttons + crash dump. -->
        <receiver
            android:name=".data.HostControlReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.godviewer.app.ACTION_TARGET_FOREGROUND" />
                <action android:name="com.godviewer.app.ACTION_TARGET_DIAG" />
                <action android:name="com.godviewer.app.ACTION_TARGET_CRASH" />
                <action android:name="com.godviewer.app.action.HOST_ENABLE_EDIT" />
                <action android:name="com.godviewer.app.action.HOST_UNDO" />
                <action android:name="com.godviewer.app.action.HOST_MANAGE_RULES" />
                <action android:name="com.godviewer.app.action.HOST_CLOSE_POPUPS" />
                <action android:name="com.godviewer.app.action.HOST_POPUP_NOTIFY_DISMISS" />
                <action android:name="com.godviewer.app.ACTION_POPUP_DETECTED" />
                <action android:name="com.godviewer.app.ACTION_POPUP_INTERCEPTED" />
                <action android:name="com.godviewer.app.ACTION_CONTROL_INTERCEPTED" />
                <action android:name="com.godviewer.app.ACTION_POPUP_INTERCEPT_REQUEST" />
            </intent-filter>
        </receiver>

        <!--
          宿主设置只读出口（仅宿主自身/adb shell 可读）：目标进程因 Android 11+
          包可见性查不到此 Provider（query 静默返回 null），开关状态已改走广播同步
          （ACTION_POPUP_INTERCEPT_REQUEST/STATE），此 Provider 保留供调试。
        -->
        <provider
            android:name=".data.HostPrefsProvider"
            android:authorities="com.godviewer.app.hostprefs"
            android:exported="true"
            android:grantUriPermissions="false" />
    </application>

</manifest>
